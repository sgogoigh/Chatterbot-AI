# Chatterbot-AI backend configuration (copy to .env). All keys are CB_-prefixed.
# See IMPLEMENTATION.md §4 and config.py for the full list + defaults.

# ---- server ----
CB_HOST=0.0.0.0
CB_PORT=8000
CB_LOG_LEVEL=INFO

# ---- models ----
CB_MODELS_DIR=/models
CB_WHISPER_MODEL=small.en
CB_WHISPER_COMPUTE_TYPE=int8
CB_PIPER_VOICE=en_US-lessac-medium

# ---- LLM (Groq primary, Ollama fallback) ----
CB_GROQ_API_KEY=                       # required for cloud LLM; leave empty to use Ollama only
CB_GROQ_MODEL=llama-3.3-70b-versatile  # R7: confirm a current Groq model id
CB_OLLAMA_BASE_URL=http://localhost:11434
CB_OLLAMA_MODEL=llama3.1:8b

# ---- LiveKit (required for live voice sessions) ----
CB_LIVEKIT_URL=                        # wss://your-livekit-host
CB_LIVEKIT_API_KEY=
CB_LIVEKIT_API_SECRET=

# ---- data ----
CB_DATA_DIR=data
